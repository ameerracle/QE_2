&CONTROL
  calculation = 'vc-relax'
  prefix = 'tin_atomic'
  pseudo_dir = '/scratch/anizami/QE_2/USPP/'
  outdir = './tmp/'
/
&SYSTEM
  ibrav = 0, nat = 8, ntyp = 2
  ecutwfc = 45, ecutrho = 450.0
  occupations = 'smearing', smearing = 'mv', degauss = 0.02,
  nspin = 1
  vdw_corr = 'dft-d3'
  dftd3_version = 4
/
&ELECTRONS
  conv_thr = 1.0d-7
  mixing_beta = 0.2
  mixing_mode = 'local-TF'
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
/
