&CONTROL
  calculation = 'vc-relax'
  prefix = 'vn_ortho_atomic'
  pseudo_dir = '/scratch/anizami/QE_2/USPP/'
  outdir = './tmp/'
/
&SYSTEM
  ibrav = 0, nat = 8, ntyp = 2
  ecutwfc = 45, ecutrho = 450.0
  occupations = 'smearing', smearing = 'mv', degauss = 0.02,
  nspin = 2
  vdw_corr = 'dft-d3'
  dftd3_version = 4
  starting_magnetization(1) = 0.15
/
&ELECTRONS
  conv_thr = 1.0d-7
  mixing_beta = 0.2
  mixing_mode = 'local-TF'
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
/
ATOMIC_SPECIES
 V 1.0 v_pbe_v1.4.uspp.F.UPF
 N 1.0 n_pbe_v1.2.uspp.F.UPF

CELL_PARAMETERS (angstrom)
    4.1023721645    0.0000000000    0.0000000000
    0.0000000000    4.1023721645    0.0000000000
    0.0000000000    0.0000000000    4.1023721645

ATOMIC_POSITIONS (crystal)
 V  0.000000000000 0.000000000000 0.000000000000
 V  0.499999999449 0.499999999449 0.000000000000
 V  0.499999999449 0.000000000000 0.499999999449
 V  0.000000000000 0.499999999449 0.499999999449
 N  0.000000000000 0.000000000000 0.499999999449
 N  0.000000000000 0.499999999449 0.000000000000
 N  0.499999999449 0.000000000000 0.000000000000
 N  0.499999999449 0.499999999449 0.499999999449

K_POINTS (automatic)
 5 5 5 0 0 0

HUBBARD {ortho-atomic}
 U V-3d 2.50
