&CONTROL
  calculation = 'vc-relax'
  prefix = 'nbn'
  pseudo_dir = '/scratch/anizami/QE_2/USPP/'
  outdir = './tmp/'
/
&SYSTEM
  ibrav = 0, nat = 8, ntyp = 2
  ecutwfc = 45, ecutrho = 450.0
  occupations = 'smearing', smearing = 'mv', degauss = 0.08
  nspin = 1
  vdw_corr = 'dft-d3'
  dftd3_version = 4
/
&ELECTRONS
  conv_thr = 1.0d-6
  mixing_beta = 0.3
  mixing_mode = 'local-TF'
  electron_maxstep = 150
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
/
ATOMIC_SPECIES
 Nb 1.0 nb_pbe_v1.uspp.F.UPF
 N 1.0 n_pbe_v1.2.uspp.F.UPF

