 Nb    2.191605370    2.191605370    0.000000000
 Nb    2.191605370    0.000000000    2.191605370
 Nb    0.000000000    2.191605370    2.191605370
 N    0.000000000    0.000000000    2.191605370
 N    0.000000000    2.191605370    0.000000000
 N    2.191605370    0.000000000    0.000000000
 N    2.191605370    2.191605370    2.191605370

K_POINTS (automatic)
 5 5 5 0 0 0

HUBBARD {ortho-atomic}
